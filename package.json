{
  "name": "bunlet-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "setup": "bun install && bun run build:native && bun run build:packages",
    "build": "bun run build:packages",
    "build:native": "cd packages/bunlet-native && bun run build",
    "build:cef": "cd packages/bunlet-cef-native && bun run build",
    "build:packages": "cd packages/bunlet && bun run build && cd ../bunlet-cli && bun run build",
    "dev": "bun run ./packages/bunlet-cli/src/cli.ts",
    "test": "bun test packages/",
    "typecheck": "(cd packages/bunlet && bun run typecheck) && (cd packages/bunlet-cli && bun run typecheck)",
    "lint": "bunx oxlint --quiet packages/*/src/",
    "doctor": "bun run scripts/doctor.ts",
    "clean": "rm -rf packages/*/dist packages/*/*.node examples/*/*.bunlet-preload.js",
    "version:bump": "bun run scripts/bump-version.ts",
    "version:changelog": "bun run scripts/generate-changelog.ts"
  },
  "devDependencies": {
    "@bunlet/cli": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  }
}