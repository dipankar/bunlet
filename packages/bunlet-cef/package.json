{
  "name": "@bunlet/cef",
  "version": "0.2.1",
  "description": "Chromium Embedded Framework (CEF) backend for Bunlet — full Chromium 146+ runtime as an alternative to system WebView",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "homepage": "https://bunlet.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dipankar/bunlet.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "cargo build --manifest-path ../bunlet-cef-native/Cargo.toml --release && bun run copy-artifact",
    "build:debug": "cargo build --manifest-path ../bunlet-cef-native/Cargo.toml && bun run copy-artifact:debug",
    "copy-artifact": "bun ./scripts/copy-artifact.js release",
    "copy-artifact:debug": "bun ./scripts/copy-artifact.js debug",
    "test": "bun test"
  },
  "optionalDependencies": {
    "@bunlet/native": "workspace:*"
  },
  "peerDependencies": {
    "@bunlet/native": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@bunlet/native": {
      "optional": true
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "scripts",
    "*.node",
    "bunlet-cef-helper",
    "bunlet-cef-helper.exe"
  ],
  "keywords": [
    "bunlet",
    "cef",
    "chromium",
    "chromium-embedded",
    "webview",
    "desktop",
    "bun",
    "embedded-browser",
    "full-chromium",
    "devtools",
    "cross-platform",
    "electron-alternative"
  ]
}
