{
  "name": "@bunlet/cef",
  "version": "0.1.0",
  "description": "CEF (Chromium Embedded Framework) backend for Bunlet",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dipankar/bunlet.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "cargo build --manifest-path ../bunlet-cef-native/Cargo.toml --release && bun run copy-artifact",
    "build:debug": "cargo build --manifest-path ../bunlet-cef-native/Cargo.toml && bun run copy-artifact:debug",
    "copy-artifact": "bun ./scripts/copy-artifact.js release",
    "copy-artifact:debug": "bun ./scripts/copy-artifact.js debug",
    "test": "bun test"
  },
  "optionalDependencies": {
    "@bunlet/native": "workspace:*"
  },
  "peerDependencies": {
    "@bunlet/native": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@bunlet/native": {
      "optional": true
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "scripts",
    "*.node",
    "bunlet-cef-helper",
    "bunlet-cef-helper.exe"
  ],
  "keywords": [
    "bunlet",
    "cef",
    "chromium",
    "webview",
    "desktop"
  ]
}
