{
  "name": "@bunlet/cli",
  "version": "0.2.3",
  "description": "Official CLI for the Bunlet desktop framework — scaffold, develop, build, and package cross-platform desktop apps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bunlet": "./bin/bunlet.js"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun && bun build ./src/cli.ts --outfile ./dist/cli.js --target bun --no-bundle",
    "typecheck": "tsc --noEmit",
    "dev": "bun run ./src/cli.ts"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "chokidar": "^3.6.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "fs-extra": "^11.2.0",
    "archiver": "^7.0.0",
    "yaml": "^2.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "bun-types": "^1.1.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "@bunlet/core": "workspace:*"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "keywords": [
    "bunlet",
    "cli",
    "bun",
    "desktop",
    "electron-alternative",
    "scaffold",
    "build-tool",
    "packaging",
    "cross-platform",
    "create-app",
    "dev-server",
    "installer",
    "typescript",
    "hot-reload"
  ],
  "homepage": "https://bunlet.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dipankar/bunlet.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
