{
  "name": "@bunlet/cli",
  "version": "0.3.0",
  "description": "CLI for Bunlet desktop framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bunlet": "./bin/bunlet.js"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun && bun build ./src/cli.ts --outfile ./dist/cli.js --target bun --no-bundle",
    "dev": "bun run ./src/cli.ts"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "chokidar": "^3.6.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "fs-extra": "^11.2.0",
    "archiver": "^7.0.0",
    "yaml": "^2.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "bun-types": "^1.1.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "bunlet": "workspace:*"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "keywords": [
    "bunlet",
    "cli",
    "desktop",
    "electron-alternative"
  ],
  "license": "MIT"
}
