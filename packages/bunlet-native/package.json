{
  "name": "@bunlet/native",
  "version": "0.1.0",
  "description": "Native bindings for Bunlet desktop framework",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dipankar/bunlet.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "*.node"
  ],
  "keywords": [
    "bunlet",
    "native",
    "webview",
    "desktop",
    "rust",
    "napi"
  ],
  "napi": {
    "name": "bunlet-native",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "scripts": {
    "build": "cargo build --release && bun run scripts/copy-artifact.js",
    "build:debug": "cargo build && bun run scripts/copy-artifact.js debug",
    "test": "cargo test"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  }
}